# ragkb 环境变量示例
#
# 默认「免 Docker 嵌入式」：以下三项留空即可（或根本不建 .env 文件），
# 数据全部落盘项目内 data/ 目录（向量 data/qdrant、表格/版本 data/ragkb.db、图片 data/images）。
#
# 仅在需要切换远程服务时设置对应变量（去掉注释并填值）：
#   - 检索存储：清空 RAGKB_QDRANT_PATH 即改为连接 RAGKB_QDRANT_URL 的远程 Qdrant
#   - 表格/版本：设置非空 RAGKB_PG_DSN 即改用 PostgreSQL（默认 SQLite）
#   - 图片存储：设置非空 RAGKB_MINIO_ENDPOINT 即改用 MinIO（默认本地目录）

# --- 检索存储（默认嵌入式；清空 RAGKB_QDRANT_PATH 可切远程）---
# RAGKB_QDRANT_PATH=data/qdrant
# RAGKB_QDRANT_URL=http://localhost:6333

# --- 表格/版本存储（默认 SQLite；设置 RAGKB_PG_DSN 可切 PostgreSQL）---
# RAGKB_SQLITE_PATH=data/ragkb.db
# RAGKB_PG_DSN=postgresql://ragkb:ragkb@localhost:5432/ragkb

# --- 图片存储（默认本地目录；设置 RAGKB_MINIO_ENDPOINT 可切 MinIO）---
# RAGKB_IMAGES_DIR=data/images
# RAGKB_MINIO_ENDPOINT=localhost:9000
# RAGKB_MINIO_ACCESS_KEY=ragkb
# RAGKB_MINIO_SECRET_KEY=ragkb-secret
# RAGKB_MINIO_BUCKET=ragkb-images

# --- 模型（默认项目内 models/，可用 RAGKB_MODEL_CACHE_DIR 覆盖）---
# RAGKB_MODEL_CACHE_DIR=models
# 国内网络建议设置 HF 镜像，避免模型下载超时：
# HF_ENDPOINT=https://hf-mirror.com
